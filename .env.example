# ---------------------------------------------------------------------------
# Axiom Pathways — environment template
#
# Copy this file to `.env.local` and fill in the real values:
#     cp .env.example .env.local
#
# `.env.local` is gitignored and must never be committed. Every value below is
# a placeholder — replace the right-hand side, keep the key names exactly.
# Restart `npm run dev` after editing; Next.js only reads env at boot.
# ---------------------------------------------------------------------------


# --- Supabase ---------------------------------------------------------------
# Dashboard → Project Settings → API

# Public project URL. Safe to expose (ships in the browser bundle).
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Public "anon" key. Safe to expose — Row Level Security is what protects data.
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...your-anon-key

# Service-role key. BYPASSES Row Level Security — full read/write on every
# table. Server-only: never prefix it with NEXT_PUBLIC_, never import it into a
# client component. `lib/supabase/admin.ts` guards this with `server-only`.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...your-service-role-key


# --- Resend (email) ---------------------------------------------------------
# resend.com → API keys → Create API Key → "Sending access" is enough.
# Starts with `re_`. Server-only — no NEXT_PUBLIC_ prefix, ever.
#
# >>> THIS IS THE RESEND API KEY. Paste it here, in .env.local. <<<
RESEND_API_KEY=re_your_resend_api_key

# TWO senders, two reputations (docs/email-program.md). Verify BOTH subdomains
# in Resend → Domains before sending. A rejection email must never land in spam
# because a Learn-module blast tanked shared reputation.
#
#   tx.   transactional — welcome, received, accepted, not selected, approved
#   news. marketing     — cohort announcements, nudges, reactivation, referral
#
# Never send from noreply@ — every one of these emails is meant to be replied to.
RESEND_FROM_TX="Matthew Park <matthew@tx.axiomapply.com>"
RESEND_FROM_NEWS="Axiom Pathways <hello@news.axiomapply.com>"

# Where replies land. A mailbox you actually read — and one that chapter leads
# and contractors cannot, because this is a minor-contact channel.
RESEND_REPLY_TO=matthew@axiompathways.org

# Mailbox in the mailto: half of the List-Unsubscribe header.
EMAIL_UNSUB_MAILBOX=unsub@axiompathways.org

# CAN-SPAM requires a postal address in commercial mail. Use a virtual mailbox
# or PO box (~$10-20/mo). NEVER a home address — this mail goes to 600 minors.
EMAIL_POSTAL_ADDRESS="Axiom Pathways, PO Box 0000, Houston, TX 00000"

# Signs unsubscribe links so nobody can opt a stranger out by editing a URL.
# Generate one with: openssl rand -hex 32
EMAIL_UNSUB_SECRET=""

# Absolute site origin. Used in email links and the unsubscribe URL.
NEXT_PUBLIC_SITE_URL=https://axiomapply.com


# --- Organisation -----------------------------------------------------------
# Federal tax ID for the nonprofit. Shown in the site footer, on the Privacy
# and Terms pages, and in the CAN-SPAM footer of every email. Public by nature.
# Format: 12-3456789. Left unset, all three places simply omit it.
NEXT_PUBLIC_ORG_EIN=


# --- Admin access -----------------------------------------------------------
# Comma-separated allowlist. An account needs BOTH `profiles.is_admin = true`
# (set from the Supabase dashboard) AND its email listed here to reach /admin.
ADMIN_EMAILS=you@example.com


# --- Cron -------------------------------------------------------------------
# Shared secret protecting /api/cron/refresh, the daily internship ingestion.
# Any long random string. Generate one with: openssl rand -hex 32
# Vercel calls this route on the schedule in vercel.json (0 13 * * *).
CRON_SECRET=generate-a-long-random-string


# --- Optional ---------------------------------------------------------------
# Google Apps Script webhook the /apply form POSTs to. Leave unset and the
# apply form degrades gracefully instead of erroring.
# NEXT_PUBLIC_APPS_SCRIPT_WEBHOOK=https://script.google.com/macros/s/.../exec

# Google Apps Script webhook for STARTUP applications — a different script,
# deployment, and spreadsheet from the intern one above. Deploy
# APPS_SCRIPT_STARTUPS.gs from the startups Sheet and paste its /exec URL.
# Server-only (no NEXT_PUBLIC_): the post happens in a server action, so the
# endpoint never appears in the client bundle. Unset = Supabase-only, no error.
# STARTUP_APPS_SCRIPT_WEBHOOK=https://script.google.com/macros/s/.../exec
