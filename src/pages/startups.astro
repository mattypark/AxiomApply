---
import "../styles/global.css";

// Design-only page. Nothing wired yet:
//  - "Book a call" is a visual underlined link (no handler / no scheduler).
//  - Founder login + email capture at booking time is a LATER task.
//  - No Google Sheet / Apps Script columns touched.

const steps = [
  { n: "01", label: "You reach out" },
  { n: "02", label: "We match a builder" },
  { n: "03", label: "They drop in and ship" },
];

const network = [
  { name: "FinalDose", yc: "YC P26" },
  { name: "Corgi", yc: "YC S24" },
  { name: "TypeOS", yc: "YC X25" },
  { name: "Anvara", yc: null },
];
---

<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <link rel="icon" type="image/png" href="/axiom-mark.png" />
  <title>For startups — Axiom Pathways</title>
  <meta name="description" content="Hungry builders, dropped into your startup. Book a call to get matched." />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Newsreader:ital,opsz,wght@0,6..72,300..600;1,6..72,300..500&display=swap" rel="stylesheet" />
</head>
<body class="startup-body">
  <div class="sp">

    <!-- top row -->
    <header class="sp-top">
      <a class="sp-back" href="/">← Back</a>
      <span class="sp-kicker">Axiom Pathways · For startups</span>
    </header>

    <!-- main: content left, a couple things right -->
    <main class="sp-main">
      <div class="sp-left">
        <h1 class="sp-title">Hungry builders,<br />dropped into<br />your startup.</h1>
        <p class="sp-sub">Young talent picked for passion, not credentials — plugged into your team to build what ships.</p>
      </div>

      <aside class="sp-right">
        <section class="sp-block">
          <span class="sp-label">How it works</span>
          <ul class="sp-list">
            {steps.map((s) => (
              <li><span class="sp-n">{s.n}</span>{s.label}</li>
            ))}
          </ul>
        </section>

        <section class="sp-block">
          <span class="sp-label">In the network</span>
          <ul class="sp-list sp-list-net">
            {network.map((c) => (
              <li>{c.name}{c.yc && <span class="sp-yc">{c.yc}</span>}</li>
            ))}
          </ul>
        </section>
      </aside>
    </main>

    <!-- bottom: the CTA + footer corners -->
    <footer class="sp-bottom">
      <!-- LATER: founder enters email + picks a time; login/booking wired in a future pass. -->
      <a class="sp-cta" href="#">Book a call ↓</a>
      <span class="sp-meta">15 min · founders only</span>
      <span class="sp-corner">Axiom Pathways</span>
    </footer>

  </div>

  <style is:global>
    /* Dark surface for this page only. */
    html:has(.startup-body), .startup-body { background: #0e0f0d; }
    body.is-leaving { opacity: 0; transition: opacity .28s ease; }
  </style>

  <style>
    .sp {
      --bg: #0e0f0d;
      --text: #f2f0e9;
      --muted: #85847b;
      --faint: #55554e;
      --accent: #3f8f52;
      --line: rgba(242, 240, 233, 0.10);

      min-height: 100vh;
      background: var(--bg);
      color: var(--text);
      font-family: var(--font-sans);
      display: flex;
      flex-direction: column;
      padding: clamp(22px, 4vw, 44px) clamp(24px, 6vw, 72px) clamp(24px, 4vw, 40px);
      gap: clamp(40px, 8vh, 90px);
    }

    /* Tiny uppercase labels (mono feel) */
    .sp-kicker, .sp-label, .sp-meta, .sp-corner {
      font-size: 0.68rem; letter-spacing: 0.2em; text-transform: uppercase; color: var(--muted);
    }

    /* Top row */
    .sp-top { display: flex; align-items: center; justify-content: space-between; gap: 16px; }
    .sp-back { font-size: 0.8rem; letter-spacing: 0.02em; color: var(--muted); transition: color .2s, transform .2s; }
    .sp-back:hover { color: var(--text); transform: translateX(-3px); }
    .sp-back:focus-visible { outline: 2px solid var(--accent); outline-offset: 3px; border-radius: 6px; }

    /* Main split — content left, small stuff right */
    .sp-main {
      flex: 1;
      display: grid;
      grid-template-columns: 1.5fr 0.85fr;
      align-items: end;
      gap: clamp(40px, 6vw, 96px);
    }

    .sp-title {
      font-family: var(--font-sans);
      font-weight: 700;
      font-size: clamp(2.9rem, 9.5vw, 8.2rem);
      line-height: 0.92;
      letter-spacing: -0.045em;
      text-wrap: balance;
    }
    .sp-sub {
      margin-top: clamp(22px, 3vw, 34px);
      max-width: 42ch;
      font-size: clamp(1.02rem, 1.5vw, 1.28rem);
      line-height: 1.5;
      color: var(--muted);
      text-wrap: pretty;
    }

    /* Right column — a couple of things */
    .sp-right { display: flex; flex-direction: column; gap: clamp(28px, 4vh, 44px); padding-bottom: 6px; }
    .sp-block { display: flex; flex-direction: column; gap: 14px; }
    .sp-label { padding-bottom: 6px; border-bottom: 1px solid var(--line); }
    .sp-list { list-style: none; display: flex; flex-direction: column; gap: 11px; }
    .sp-list li { display: flex; align-items: baseline; gap: 12px; font-size: 1.02rem; color: var(--text); }
    .sp-n { font-size: 0.72rem; letter-spacing: 0.08em; color: var(--accent); flex-shrink: 0; }
    .sp-list-net li { justify-content: space-between; }
    .sp-yc { font-size: 0.62rem; letter-spacing: 0.06em; color: var(--faint); }

    /* Bottom row — the CTA + footer meta */
    .sp-bottom { display: flex; align-items: baseline; gap: clamp(18px, 3vw, 32px); flex-wrap: wrap; }
    .sp-cta {
      font-size: clamp(1.05rem, 1.6vw, 1.3rem);
      font-weight: 600;
      color: var(--text);
      padding-bottom: 4px;
      border-bottom: 2px solid var(--text);
      transition: color .22s, border-color .22s;
    }
    .sp-cta:hover { color: var(--accent); border-color: var(--accent); }
    .sp-cta:focus-visible { outline: 2px solid var(--accent); outline-offset: 4px; }
    .sp-corner { margin-left: auto; }

    /* Responsive — stack, content-first */
    @media (max-width: 780px) {
      .sp-main { grid-template-columns: 1fr; align-items: start; gap: clamp(36px, 8vh, 56px); }
      .sp-right { flex-direction: row; flex-wrap: wrap; gap: 32px; }
      .sp-block { min-width: 160px; }
      .sp-corner { margin-left: 0; width: 100%; }
    }

    @media (prefers-reduced-motion: reduce) {
      .sp-back, .sp-cta { transition: none; }
    }
  </style>

  <script>
    // Page transition: fade out before navigating internally (matches other pages).
    const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    document.addEventListener("click", (e) => {
      const a = (e.target as HTMLElement).closest("a[href]") as HTMLAnchorElement | null;
      if (!a) return;
      const url = a.getAttribute("href");
      if (!url || a.target === "_blank" || /^(https?:|mailto:|#)/.test(url)) return;
      e.preventDefault();
      if (reduce) { window.location.href = url; return; }
      document.body.classList.add("is-leaving");
      setTimeout(() => { window.location.href = url; }, 280);
    });
  </script>
</body>
</html>
